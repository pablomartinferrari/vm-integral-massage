---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import MobileBookBar from '../components/MobileBookBar.astro';
import JsonLd from '../components/JsonLd.astro';
import WpRedirectScript from '../components/WpRedirectScript.astro';
import AssistantSlot from '../components/AssistantSlot.astro';
import { copy, site } from '../lib/content';
import { htmlLang, tPath, type Locale, type PageKey } from '../lib/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  page: PageKey;
  canonicalPath: string;
  alternatePath: string;
  ogImage?: string;
}

const {
  locale,
  title,
  description,
  page,
  canonicalPath,
  alternatePath,
  ogImage = '/images/og.jpg',
} = Astro.props;

const t = copy(locale);
const canonical = new URL(canonicalPath, Astro.site);
const alternate = new URL(alternatePath, Astro.site);
const og = new URL(ogImage, Astro.site);
const fullTitle = `${title} · ${site.brandName}`;
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#100e0c" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={locale === 'en' ? 'en-US' : 'es-US'} href={canonical.href} />
    <link rel="alternate" hreflang={locale === 'en' ? 'es-US' : 'en-US'} href={alternate.href} />
    <link rel="alternate" hreflang="x-default" href={new URL(tPath('en', page), Astro.site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brandName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={og.href} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={t.meta.ogLocaleAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.href} />
    <link rel="icon" href="/favicon.jpg" type="image/jpeg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <JsonLd locale={locale} />
    <WpRedirectScript locale={locale} />
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased">
    <a class="skip-link" href="#content">{t.nav.skip}</a>
    <Header locale={locale} page={page} alternatePath={alternatePath} />
    <main id="content">
      <slot />
    </main>
    <Footer locale={locale} />
    <WhatsAppButton locale={locale} />
    <MobileBookBar locale={locale} />
    <AssistantSlot locale={locale} />
  </body>
</html>
