---
import Base from '../../layouts/Base.astro';
import PaymentNote from '../PaymentNote.astro';
import { copy, site } from '../../lib/content';
import { tPath, whatsappUrl, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<Base
  locale={locale}
  page="contact"
  title={t.meta.contactTitle}
  description={t.meta.contactDescription}
  canonicalPath={tPath(locale, 'contact')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'contact')}
>
  <section class="bg-night py-16 text-ivory md:py-24">
    <div class="mx-auto max-w-4xl px-4 md:px-6">
      <p class="text-xs tracking-[0.25em] uppercase text-gold">{t.contactPage.eyebrow}</p>
      <h1 class="mt-4 font-serif text-5xl md:text-6xl">{t.contactPage.title}</h1>
      <p class="mt-5 max-w-xl text-ivory/75">{t.contactPage.lede}</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-2 md:px-6 md:py-24">
    <div class="space-y-8">
      <div>
        <p class="text-xs tracking-[0.2em] uppercase text-gold-deep">{t.contactPage.locationTitle}</p>
        <p class="mt-2 font-serif text-3xl">{site.address.full}</p>
        <a class="mt-3 inline-block text-sm text-gold-deep" href={site.mapsUrl} rel="noopener noreferrer">
          {t.cta.getDirections} →
        </a>
      </div>
      <div>
        <p class="text-xs tracking-[0.2em] uppercase text-gold-deep">{t.contactPage.hoursTitle}</p>
        <ul class="mt-3 space-y-2 text-lg">
          {
            site.hours.map((h) => (
              <li class="flex justify-between gap-6 border-b border-sand py-2">
                <span>{locale === 'es' ? h.daysEs : h.daysEn}</span>
                <span>{locale === 'es' ? h.displayEs : h.displayEn}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="text-xs tracking-[0.2em] uppercase text-gold-deep">{t.contactPage.contactTitle}</p>
        <p class="mt-3">
          <a class="text-lg hover:text-gold-deep" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        </p>
        <p>
          <a class="text-lg hover:text-gold-deep" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="mt-6 text-sm text-ink-soft">{t.contactPage.bookingNote}</p>
        <div class="mt-8">
          <PaymentNote locale={locale} />
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            class="rounded-full bg-gold px-5 py-3 text-sm tracking-[0.12em] uppercase text-night"
            href={whatsappUrl(site.whatsapp, t.cta.whatsappPrefill)}>{t.cta.bookWhatsApp}</a
          >
          <a class="rounded-full border border-ink/20 px-5 py-3 text-sm tracking-[0.12em] uppercase" href={`tel:${site.phoneTel}`}>
            {t.cta.call}
          </a>
          <a class="rounded-full border border-ink/20 px-5 py-3 text-sm tracking-[0.12em] uppercase" href={`mailto:${site.email}`}>
            {t.cta.email}
          </a>
        </div>
      </div>
    </div>
    <div class="min-h-[360px] overflow-hidden rounded-3xl border border-sand">
      <iframe
        title={site.address.full}
        src={site.mapsEmbed}
        class="h-full min-h-[360px] w-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>
</Base>
