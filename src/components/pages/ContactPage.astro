---
import Base from '../../layouts/Base.astro';
import FaqSection from '../FaqSection.astro';
import PageHero from '../PageHero.astro';
import PaymentNote from '../PaymentNote.astro';
import { copy, site } from '../../lib/content';
import { tPath, whatsappUrl, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<Base
  locale={locale}
  page="contact"
  title={t.meta.contactTitle}
  description={t.meta.contactDescription}
  canonicalPath={tPath(locale, 'contact')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'contact')}
>
  <PageHero eyebrow={t.contactPage.eyebrow} title={t.contactPage.title} lede={t.contactPage.lede} />

  <section class="section mx-auto grid max-w-6xl gap-10 px-4 md:grid-cols-2 md:px-6">
    <div class="space-y-8">
      <div>
        <p class="eyebrow">{t.contactPage.locationTitle}</p>
        <p class="mt-2 font-serif text-3xl"><a class="hover:text-gold-deep" data-map-link href={site.mapsUrl} rel="noopener noreferrer">{site.address.full}</a></p>
        <a class="mt-3 inline-block text-sm font-medium text-gold-ink hover:text-gold-deep" data-map-link href={site.mapsUrl} rel="noopener noreferrer">
          {t.cta.getDirections} →
        </a>
      </div>
      <div>
        <p class="eyebrow">{t.contactPage.hoursTitle}</p>
        <ul class="mt-3 space-y-2 text-lg">
          {
            site.hours.map((h) => (
              <li class="flex justify-between gap-6 border-b border-sand py-2">
                <span>{locale === 'es' ? h.daysEs : h.daysEn}</span>
                <span>{locale === 'es' ? h.displayEs : h.displayEn}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="eyebrow">{t.contactPage.contactTitle}</p>
        <p class="mt-3">
          <a class="text-lg hover:text-gold-ink" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a>
        </p>
        <p>
          <a class="text-lg hover:text-gold-ink" href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="mt-6 text-base text-ink-soft">{t.contactPage.bookingNote}</p>
        <div class="card mt-8 p-6">
          <PaymentNote locale={locale} />
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">{t.cta.bookOnline}</a>
          <a class="btn btn-ghost" href={whatsappUrl(site.whatsapp, t.cta.whatsappPrefill)}>{t.cta.bookWhatsApp}</a>
          <a class="btn btn-ghost" href={`tel:${site.phoneTel}`}>
            {t.cta.call}
          </a>
          <a class="btn btn-ghost" href={`mailto:${site.email}`}>
            {t.cta.email}
          </a>
        </div>
      </div>
    </div>
    <div class="min-h-[360px] overflow-hidden rounded-[var(--radius-card)] border border-sand shadow-card">
      <iframe
        title={site.address.full}
        src={site.mapsEmbed}
        class="h-full min-h-[360px] w-full border-0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </section>

  <FaqSection locale={locale} />
</Base>
