---
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import FaqSection from '../FaqSection.astro';
import MembershipTeaser from '../MembershipTeaser.astro';
import ServiceCard from '../ServiceCard.astro';
import { copy, site, services, testimonials, pricing, formatUsd } from '../../lib/content';
import { servicesHash, tPath, whatsappUrl, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
const featured = testimonials.slice(0, 4);
const weekday = site.hours[0];
const saturday = site.hours[1];
---

<Base
  locale={locale}
  page="home"
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  canonicalPath={tPath(locale, 'home')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'home')}
>
  <section class="relative min-h-[70vh] overflow-hidden bg-night text-ivory md:min-h-[75vh] lg:min-h-[80vh]">
    <img
      src="/images/hero.jpg"
      alt={t.alts.hero}
      width="1920"
      height="1280"
      class="absolute inset-0 h-full w-full object-cover object-center"
      fetchpriority="high"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-night/88 via-night/58 to-night/28"></div>
    <div
      class="relative mx-auto flex min-h-[70vh] max-w-6xl flex-col justify-center px-4 py-24 md:min-h-[75vh] md:px-6 lg:min-h-[80vh]"
    >
      <p class="eyebrow eyebrow-on-dark">{t.hero.eyebrow}</p>
      <h1 class="hero-title mt-5 max-w-3xl font-serif text-[2.6rem] leading-[1.12] md:text-6xl lg:text-[4.15rem]">
        {t.hero.title}
      </h1>
      <p class="lede mt-6 max-w-xl text-pretty text-ivory/90">{t.hero.lede}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={whatsappUrl(site.whatsapp, t.cta.whatsappPrefill)}>{t.cta.bookWhatsApp}</a>
        <a class="btn btn-secondary" href={tPath(locale, 'services')}>{t.cta.viewServices}</a>
      </div>
    </div>
  </section>

  <section class="border-b border-sand/80 bg-ivory">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 pr-20 sm:grid-cols-2 md:px-6 lg:grid-cols-4 lg:pr-24">
      <div>
        <p class="eyebrow">{t.homeFacts.studio}</p>
        <p class="mt-2 font-serif text-xl text-ink"><a class="underline decoration-sand underline-offset-4 hover:text-gold-deep" data-map-link href={site.mapsUrl} rel="noopener noreferrer">{site.address.full}</a></p>
      </div>
      <div>
        <p class="eyebrow">{t.homeFacts.hours}</p>
        <p class="mt-2 text-base leading-relaxed text-ink-soft">
          {locale === 'es' ? weekday.daysEs : weekday.daysEn}
          {' '}
          {locale === 'es' ? weekday.displayEs : weekday.displayEn}
          <br />
          {locale === 'es' ? saturday.daysEs : saturday.daysEn}
          {' '}
          {locale === 'es' ? saturday.displayEs : saturday.displayEn}
        </p>
      </div>
      {
        pricing.showPrices && (
          <>
            <div>
              <p class="eyebrow">{t.homeFacts.from}</p>
              <p class="mt-2 font-serif text-3xl tabular-nums text-ink">{formatUsd(pricing.fromPrice)}</p>
            </div>
            <div>
              <p class="eyebrow">{t.homeFacts.offer}</p>
              <p class="mt-2 font-serif text-3xl tabular-nums text-ink">{formatUsd(pricing.introOffer.price)}</p>
              <p class="mt-1 text-sm text-ink-soft">{pricing.introOffer.detail[locale]}</p>
            </div>
          </>
        )
      }
    </div>
  </section>

  <section class="section mx-auto max-w-6xl px-4 md:px-6">
    <div class="grid items-end gap-6 md:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="eyebrow">{t.attention.eyebrow}</p>
        <div class="gold-rule mt-4"></div>
        <h2 class="mt-5 max-w-xl font-serif text-4xl md:text-5xl">{t.attention.title}</h2>
      </div>
      <p class="measure text-ink-soft">{t.attention.intro}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((s) => (
          <div class:list={[s.id === 'post-operative' && 'sm:col-span-2 lg:col-span-2']}>
            <div id={s.anchors[0]} class="scroll-mt-28">
              <ServiceCard locale={locale} service={s} compact={s.id !== 'post-operative'} />
            </div>
          </div>
        ))
      }
    </div>
    {
      pricing.showPrices && (
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a class="btn btn-ghost" href={servicesHash(locale, 'pricing')}>
            {t.pricing.viewMenu}
          </a>
          {pricing.giftCards.enabled && (
            <p class="max-w-xl text-base leading-relaxed text-ink-soft">
              {t.pricing.giftCardsHome}{' '}
              <a class="font-medium text-gold-ink underline decoration-gold/60 underline-offset-4 hover:text-gold-deep" href={whatsappUrl(site.whatsapp, t.cta.giftCardPrefill)}>
                {t.pricing.giftCardsCta}
              </a>
            </p>
          )}
        </div>
      )
    }
  </section>

  <section class="bg-ivory">
    <div class="section mx-auto grid max-w-6xl items-center gap-10 px-4 md:grid-cols-2 md:px-6">
      <img
        src="/images/gallery/clinic-lymphatic-01.jpg"
        alt={t.alts.clinicLymphatic}
        width="900"
        height="700"
        loading="lazy"
        decoding="async"
        class="h-[380px] w-full rounded-[var(--radius-card)] object-cover shadow-card md:h-[460px]"
      />
      <div>
        <p class="eyebrow">{t.aboutPreview.eyebrow}</p>
        <div class="gold-rule mt-4"></div>
        <h2 class="mt-5 font-serif text-4xl md:text-[2.75rem]">{t.aboutPreview.title}</h2>
        <p class="mt-5 max-w-xl leading-relaxed text-ink-soft">{t.aboutPreview.body}</p>
        <a class="mt-6 inline-flex text-sm font-medium tracking-[0.12em] uppercase text-gold-ink hover:text-gold-deep" href={tPath(locale, 'about')}>
          {t.aboutPreview.link} →
        </a>
      </div>
    </div>
  </section>

  <MembershipTeaser locale={locale} />

  <section class="section mx-auto max-w-6xl px-4 md:px-6">
    <p class="eyebrow">{t.reviews.eyebrow}</p>
    <h2 class="mt-4 max-w-2xl font-serif text-4xl md:text-5xl">{t.reviews.title}</h2>
    <p class="mt-3 max-w-2xl text-base text-ink-soft">{t.reviews.source}</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2">
      {
        featured.map((review) => (
          <blockquote class="card p-6 md:p-8">
            <p class="font-serif text-xl leading-relaxed text-ink md:text-[1.45rem]">
              “{locale === 'es' ? review.quoteEs : review.quoteEn}”
            </p>
            <footer class="mt-5 text-sm text-ink-soft">
              {review.name}
              {review.location ? ` · ${review.location}` : ''}
            </footer>
          </blockquote>
        ))
      }
    </div>
  </section>

  <FaqSection locale={locale} />

  <CtaBand locale={locale} heading={t.nav.bookNow} />
</Base>
