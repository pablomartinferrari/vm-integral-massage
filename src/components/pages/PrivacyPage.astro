---
import Base from '../../layouts/Base.astro';
import TodoNote from '../TodoNote.astro';
import { copy } from '../../lib/content';
import { tPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<Base
  locale={locale}
  page="privacy"
  title={t.meta.privacyTitle}
  description={t.meta.privacyDescription}
  canonicalPath={tPath(locale, 'privacy')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'privacy')}
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:px-6">
    <p class="text-xs tracking-[0.25em] uppercase text-gold-deep">{t.privacyPage.eyebrow}</p>
    <h1 class="mt-4 font-serif text-5xl">{t.privacyPage.title}</h1>
    <div class="mt-8 space-y-5 leading-relaxed text-ink-soft">
      <p>{t.privacyPage.intro}</p>
      <p>{t.privacyPage.body1}</p>
      <p>{t.privacyPage.body2}</p>
      <p>{t.privacyPage.contact}</p>
    </div>
    <TodoNote text={t.privacyPage.body3} />
  </section>
</Base>
