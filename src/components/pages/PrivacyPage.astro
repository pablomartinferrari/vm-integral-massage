---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import TodoNote from '../TodoNote.astro';
import { copy } from '../../lib/content';
import { tPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<Base
  locale={locale}
  page="privacy"
  title={t.meta.privacyTitle}
  description={t.meta.privacyDescription}
  canonicalPath={tPath(locale, 'privacy')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'privacy')}
>
  <PageHero eyebrow={t.privacyPage.eyebrow} title={t.privacyPage.title} />
  <section class="section mx-auto max-w-3xl px-4 md:px-6">
    <div class="space-y-5 leading-relaxed text-ink">
      <p>{t.privacyPage.intro}</p>
      <p>{t.privacyPage.body1}</p>
      <p>{t.privacyPage.body2}</p>
      <p>{t.privacyPage.contact}</p>
    </div>
    <TodoNote text={t.privacyPage.body3} />
  </section>
</Base>
