---
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import { copy, testimonials } from '../../lib/content';
import { tPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
const aboutQuote = testimonials.find((item) => item.id === 'alvert-escobar');
const clinic = [
  { src: '/images/gallery/clinic-lymphatic-01.jpg', alt: t.aboutPage.galleryIntro },
  { src: '/images/gallery/clinic-lymphatic-02.jpg', alt: t.aboutPage.galleryIntro },
  { src: '/images/shoulder-massage.jpg', alt: '' },
  { src: '/images/couples-massage.jpg', alt: '' },
];
const results = [
  '/images/results/result-01.jpg',
  '/images/results/result-02.jpg',
  '/images/results/result-03.jpg',
  '/images/results/result-04.jpg',
  '/images/results/result-05.jpg',
  '/images/results/result-06.jpg',
];
---

<Base
  locale={locale}
  page="about"
  title={t.meta.aboutTitle}
  description={t.meta.aboutDescription}
  canonicalPath={tPath(locale, 'about')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'about')}
>
  <section class="bg-night py-16 text-ivory md:py-24">
    <div class="mx-auto max-w-4xl px-4 md:px-6">
      <p class="text-xs tracking-[0.25em] uppercase text-gold">{t.aboutPage.eyebrow}</p>
      <h1 class="mt-4 font-serif text-5xl md:text-6xl">{t.aboutPage.title}</h1>
      <p class="mt-4 font-serif text-2xl text-gold">{t.aboutPage.studio}</p>
      <p class="mt-2 text-ivory/70">{t.aboutPage.tagline}</p>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-2 md:px-6 md:py-24">
    <div class="space-y-5 text-lg leading-relaxed text-ink-soft">
      <p>{t.aboutPage.experience}</p>
      <p>{t.aboutPage.commitment}</p>
      <p>{t.aboutPage.experts}</p>
    </div>
    {
      aboutQuote && (
        <blockquote class="rounded-3xl bg-ivory p-8">
          <p class="font-serif text-2xl leading-relaxed">
            “{locale === 'es' ? aboutQuote.quoteEs : aboutQuote.quoteEn}”
          </p>
          <footer class="mt-6 text-sm text-ink-soft">
            {aboutQuote.name}
            {aboutQuote.location ? ` · ${aboutQuote.location}` : ''}
          </footer>
        </blockquote>
      )
    }
  </section>

  <section class="bg-ivory px-4 py-16 md:px-6 md:py-24">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-serif text-4xl">{t.aboutPage.missionTitle}</h2>
      <div class="gold-rule mt-4"></div>
      <div class="mt-8 space-y-5 leading-relaxed text-ink-soft">
        <p>{t.aboutPage.mission1}</p>
        <p>{t.aboutPage.mission2}</p>
        <p>{t.aboutPage.mission3}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 md:px-6">
    <h2 class="font-serif text-4xl">{t.aboutPage.galleryTitle}</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">{t.aboutPage.galleryIntro}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        clinic.map((img) => (
          <img src={img.src} alt={img.alt} class="h-72 w-full rounded-3xl object-cover" />
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 md:px-6 md:pb-24">
    <h2 class="font-serif text-4xl">{t.aboutPage.resultsTitle}</h2>
    <p class="mt-3 max-w-2xl text-ink-soft">{t.aboutPage.resultsIntro}</p>
    <p class="mt-2 text-sm text-ink-soft">{t.aboutPage.resultsNote}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        results.map((src, i) => (
          <img
            src={src}
            alt={
              locale === 'es'
                ? `Resultado post operatorio ${i + 1}`
                : `Post-operative result ${i + 1}`
            }
            class="h-72 w-full rounded-3xl object-cover"
          />
        ))
      }
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>
