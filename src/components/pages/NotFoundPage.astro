---
import Base from '../../layouts/Base.astro';
import { copy } from '../../lib/content';
import { tPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<Base
  locale={locale}
  page="home"
  title={t.meta.notFoundTitle}
  description={t.notFound.body}
  canonicalPath="/404"
  alternatePath={locale === 'en' ? '/es' : '/'}
>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center">
    <h1 class="font-serif text-5xl">{t.notFound.title}</h1>
    <p class="mt-4 text-ink-soft">{t.notFound.body}</p>
    <a class="btn btn-primary mt-8" href={tPath(locale, 'home')}>
      {t.notFound.home}
    </a>
  </section>
</Base>
