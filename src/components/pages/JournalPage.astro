---
import Base from '../../layouts/Base.astro';
import TodoNote from '../TodoNote.astro';
import { copy } from '../../lib/content';
import { tPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<Base
  locale={locale}
  page="journal"
  title={t.meta.journalTitle}
  description={t.meta.journalDescription}
  canonicalPath={tPath(locale, 'journal')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'journal')}
>
  <section class="mx-auto max-w-3xl px-4 py-20 md:px-6">
    <p class="text-xs tracking-[0.25em] uppercase text-gold-deep">{t.journalPage.eyebrow}</p>
    <h1 class="mt-4 font-serif text-5xl">{t.journalPage.title}</h1>
    <p class="mt-6 leading-relaxed text-ink-soft">{t.journalPage.empty}</p>
    <TodoNote text={t.journalPage.todo} />
  </section>
</Base>
