---
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import TodoNote from '../TodoNote.astro';
import { copy } from '../../lib/content';
import { tPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<Base
  locale={locale}
  page="journal"
  title={t.meta.journalTitle}
  description={t.meta.journalDescription}
  canonicalPath={tPath(locale, 'journal')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'journal')}
>
  <PageHero eyebrow={t.journalPage.eyebrow} title={t.journalPage.title} />
  <section class="section mx-auto max-w-3xl px-4 md:px-6">
    <p class="leading-relaxed text-ink">{t.journalPage.empty}</p>
    <TodoNote text={t.journalPage.todo} />
  </section>
</Base>
