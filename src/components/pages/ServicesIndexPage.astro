---
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import MembershipSection from '../MembershipSection.astro';
import PageHero from '../PageHero.astro';
import PricingSection from '../PricingSection.astro';
import ServiceCard from '../ServiceCard.astro';
import { copy, services } from '../../lib/content';
import { tPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<Base
  locale={locale}
  page="services"
  title={t.meta.servicesTitle}
  description={t.meta.servicesDescription}
  canonicalPath={tPath(locale, 'services')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'services')}
>
  <PageHero eyebrow={t.servicesPage.eyebrow} title={t.servicesPage.title} lede={t.servicesPage.lede} />

  <section class="section mx-auto max-w-6xl px-4 md:px-6">
    <div class="grid gap-6 md:grid-cols-2">
      {
        services.map((s) => (
          <div>
            {s.anchors.map((anchor) => (
              <div id={anchor} class="scroll-mt-28" />
            ))}
            <ServiceCard locale={locale} service={s} showPrice={false} />
          </div>
        ))
      }
    </div>
  </section>

  <PricingSection locale={locale} />
  <MembershipSection locale={locale} />
  <CtaBand locale={locale} />
</Base>
