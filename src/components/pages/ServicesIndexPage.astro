---
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import PageHero from '../PageHero.astro';
import ServiceCard from '../ServiceCard.astro';
import { copy, pricing, services } from '../../lib/content';
import { tPath, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<Base
  locale={locale}
  page="services"
  title={t.meta.servicesTitle}
  description={t.meta.servicesDescription}
  canonicalPath={tPath(locale, 'services')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'services')}
>
  <PageHero eyebrow={t.servicesPage.eyebrow} title={t.servicesPage.title} lede={t.servicesPage.lede} />

  <section class="section mx-auto max-w-6xl px-4 md:px-6">
    <div class="grid gap-6 md:grid-cols-2">
      {
        services.map((s) => (
          <div>
            {s.anchors.map((anchor) => (
              <div id={anchor} class="scroll-mt-28" />
            ))}
            <ServiceCard locale={locale} service={s} />
          </div>
        ))
      }
    </div>
    {
      pricing.showPrices ? (
        <p class="mt-12">
          <a class="btn btn-ghost" href={tPath(locale, 'pricing')}>
            {t.pricing.viewMenu}
          </a>
        </p>
      ) : (
        <p class="mt-12 text-base text-ink-soft">{t.pricing.contactForPricing}</p>
      )
    }
  </section>

  <CtaBand locale={locale} />
</Base>
