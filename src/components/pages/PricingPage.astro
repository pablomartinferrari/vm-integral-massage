---
import Base from '../../layouts/Base.astro';
import CtaBand from '../CtaBand.astro';
import MembershipSection from '../MembershipSection.astro';
import PaymentNote from '../PaymentNote.astro';
import { copy, site, pricing, formatUsd } from '../../lib/content';
import { tPath, whatsappUrl, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<Base
  locale={locale}
  page="pricing"
  title={t.meta.pricingTitle}
  description={t.meta.pricingDescription}
  canonicalPath={tPath(locale, 'pricing')}
  alternatePath={tPath(locale === 'en' ? 'es' : 'en', 'pricing')}
>
  <section class="bg-night py-16 text-ivory md:py-24">
    <div class="mx-auto max-w-4xl px-4 md:px-6">
      <p class="text-xs tracking-[0.25em] uppercase text-gold">{t.pricing.eyebrow}</p>
      <h1 class="mt-4 font-serif text-5xl md:text-6xl">{t.pricing.title}</h1>
      <p class="mt-5 max-w-2xl text-ivory/75">{t.pricing.lede}</p>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-24">
    {
      !pricing.showPrices ? (
        <p class="font-serif text-3xl text-ink-soft">{t.pricing.contactForPricing}</p>
      ) : (
        <div class="space-y-14">
          <div>
            <p class="text-xs tracking-[0.2em] uppercase text-gold-deep">{t.pricing.sessionsEyebrow}</p>
            <h2 class="mt-2 font-serif text-3xl">{t.pricing.sessionsTitle}</h2>
            <p class="mt-3 text-sm text-ink-soft">{t.pricing.sessionsNote}</p>
            <ul class="mt-6 divide-y divide-sand/80 border-y border-sand">
              {pricing.sessions.map((option) => (
                <li class="flex items-baseline justify-between gap-4 py-4">
                  <span>{option.label[locale]}</span>
                  <span class="font-serif text-2xl tabular-nums">{formatUsd(option.price)}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-3xl border border-sand bg-ivory px-6 py-7 md:px-8">
            <p class="text-xs tracking-[0.2em] uppercase text-gold-deep">{t.pricing.offerEyebrow}</p>
            <h2 class="mt-2 font-serif text-3xl">{t.pricing.offerTitle}</h2>
            <p class="mt-6 flex items-baseline justify-between gap-4">
              <span>{pricing.introOffer.label[locale]}</span>
              <span class="font-serif text-2xl tabular-nums">{formatUsd(pricing.introOffer.price)}</span>
            </p>
            <p class="mt-3 text-sm text-ink-soft">{pricing.introOffer.detail[locale]}</p>
          </div>

          <div>
            <p class="text-xs tracking-[0.2em] uppercase text-gold-deep">{t.pricing.moreEyebrow}</p>
            <ul class="mt-4 divide-y divide-sand/80 border-y border-sand">
              <li class="flex items-baseline justify-between gap-4 py-4">
                <span>{pricing.couples.label[locale]}</span>
                <span class="font-serif text-2xl tabular-nums">{formatUsd(pricing.couples.price)}</span>
              </li>
            </ul>
          </div>

          <div>
            <p class="text-xs tracking-[0.2em] uppercase text-gold-deep">{t.pricing.packagesEyebrow}</p>
            <h2 class="mt-2 font-serif text-3xl">{t.pricing.packagesTitle}</h2>
            <ul class="mt-6 divide-y divide-sand/80 border-y border-sand">
              {pricing.packages.map((option) => (
                <li class="flex items-baseline justify-between gap-4 py-4">
                  <span>{option.label[locale]}</span>
                  <span class="font-serif text-2xl tabular-nums">{formatUsd(option.price)}</span>
                </li>
              ))}
            </ul>
            <p class="mt-4 text-sm leading-relaxed text-ink-soft">{t.pricing.packageNote}</p>
          </div>
        </div>
      )
    }

    {
      pricing.giftCards.enabled && (
        <div id="gift-cards" class="mt-14 scroll-mt-24">
          <p class="text-xs tracking-[0.2em] uppercase text-gold-deep">{t.pricing.giftCardsEyebrow}</p>
          <h2 class="mt-2 font-serif text-3xl">{t.pricing.giftCardsTitle}</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">{t.pricing.giftCardsBody}</p>
          <a
            class="mt-6 inline-block rounded-full bg-gold px-6 py-3 text-sm tracking-[0.12em] uppercase text-night hover:bg-gold-deep hover:text-cream"
            href={whatsappUrl(site.whatsapp, t.cta.giftCardPrefill)}
          >
            {t.pricing.giftCardsCta}
          </a>
        </div>
      )
    }

    <div class="mt-14">
      <PaymentNote locale={locale} />
    </div>
  </section>

  <MembershipSection locale={locale} />
  <CtaBand locale={locale} />
</Base>
