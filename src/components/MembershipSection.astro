---
import { copy, site, pricing, formatUsd } from '../lib/content';
import { whatsappUrl, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
const m = pricing.membership;
const join = whatsappUrl(site.whatsapp, t.cta.membershipPrefill);
---

{
  pricing.showPrices && m.enabled && (
    <section id="membership" class="scroll-mt-24 bg-night py-16 text-ivory md:py-24">
      <div class="mx-auto max-w-3xl px-4 md:px-6">
        <p class="text-xs tracking-[0.25em] uppercase text-gold">{t.pricing.membershipEyebrow}</p>
        <h2 class="mt-3 font-serif text-4xl md:text-5xl">{m.name[locale]}</h2>
        <p class="mt-3 font-serif text-xl italic text-gold md:text-2xl">{m.tagline[locale]}</p>
        <p class="mt-8 font-serif text-5xl tabular-nums md:text-6xl">
          {formatUsd(m.price)}
          <span class="ml-2 align-middle font-sans text-base tracking-[0.14em] uppercase text-ivory/60">
            {m.period[locale]}
          </span>
        </p>

        <ol class="mt-12 space-y-7">
          {m.benefits.map((benefit, index) => (
            <li>
              <p class="text-xs tracking-[0.2em] uppercase text-gold">
                {String(index + 1).padStart(2, '0')} · {benefit.title[locale]}
              </p>
              <p class="mt-2 leading-relaxed text-ivory/80">{benefit.body[locale]}</p>
              {'items' in benefit && Array.isArray(benefit.items) && benefit.items.length > 0 && (
                <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-ivory/70">
                  {benefit.items.map((item) => (
                    <li>{item[locale]}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ol>

        <div class="mt-12 flex flex-wrap items-center gap-3">
          <a
            class="rounded-full bg-gold px-6 py-3 text-sm tracking-[0.12em] uppercase text-night hover:bg-gold-deep hover:text-cream"
            href={join}
          >
            {m.cta[locale]}
          </a>
          <a
            class="rounded-full border border-ivory/30 px-6 py-3 text-sm tracking-[0.12em] uppercase hover:border-gold hover:text-gold"
            href={site.social.instagram}
            rel="noopener noreferrer"
          >
            Instagram @vmintegralmassage
          </a>
          <a
            class="rounded-full border border-ivory/30 px-6 py-3 text-sm tracking-[0.12em] uppercase hover:border-gold hover:text-gold"
            href={site.social.facebook}
            rel="noopener noreferrer"
          >
            Facebook @vmintegralmassage
          </a>
        </div>
      </div>
    </section>
  )
}
