---
import { copy } from '../lib/content';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<section class="section mx-auto max-w-3xl px-4 md:px-6" id="faq">
  <p class="eyebrow">{t.faq.eyebrow}</p>
  <div class="gold-rule mt-4"></div>
  <h2 class="mt-5 font-serif text-4xl md:text-5xl">{t.faq.title}</h2>
  <dl class="mt-10 divide-y divide-sand/80 border-y border-sand/80">
    {
      t.faq.items.map((item) => (
        <div class="py-6">
          <dt class="font-serif text-2xl text-ink">{item.q}</dt>
          <dd class="mt-2 leading-relaxed text-ink-soft">{item.a}</dd>
        </div>
      ))
    }
  </dl>
</section>
