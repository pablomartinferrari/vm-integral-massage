---
import { copy, pricing } from '../lib/content';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

{
  pricing.showPrices && (
    <p class="text-xs tracking-wide text-ink-soft/80">
      <span class="italic">{t.pricing.sampleNote}</span>
      {' '}
      {t.pricing.confirmedNote}
    </p>
  )
}
