---
import { copy } from '../lib/content';
import type { Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<div>
  <p class="eyebrow">{t.contactPage.paymentTitle}</p>
  <p class="mt-3 leading-relaxed text-ink-soft">{t.contactPage.paymentBody}</p>
</div>
