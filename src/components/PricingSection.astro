---
import PageHero from './PageHero.astro';
import PaymentNote from './PaymentNote.astro';
import { copy, site, pricing, formatUsd } from '../lib/content';
import { whatsappUrl, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
const book = site.bookingUrl;
const gift = whatsappUrl(site.whatsapp, t.cta.giftCardPrefill);

function perSessionCopy(total: number, sessions: number) {
  const amount = formatUsd(total / sessions);
  return t.pricing.perSession.replace('{amount}', amount);
}
---

<PageHero
  id="pricing"
  headingLevel="h2"
  eyebrow={t.pricing.eyebrow}
  title={t.pricing.title}
  lede={t.pricing.lede}
/>

<section class="section mx-auto max-w-6xl px-4 md:px-6">
  {
    !pricing.showPrices ? (
      <p class="font-serif text-3xl text-ink-soft">{t.pricing.contactForPricing}</p>
    ) : (
      <div class="space-y-16">
        <div>
          <p class="eyebrow">{t.pricing.sessionsEyebrow}</p>
          <h2 class="mt-2 font-serif text-3xl md:text-4xl">{t.pricing.sessionsTitle}</h2>
          <p class="mt-3 max-w-2xl text-base text-ink-soft">{t.pricing.sessionsNote}</p>
          <ul class="mt-8 grid gap-4 sm:grid-cols-3">
            {pricing.sessions.map((option) => (
              <li class="card flex flex-col p-6 md:p-7">
                <p class="font-serif text-2xl text-ink">{option.label[locale]}</p>
                <p class="mt-5 font-serif text-4xl tabular-nums text-ink md:text-[2.75rem]">{formatUsd(option.price)}</p>
                <a class="btn btn-ghost mt-6 w-full" href={book} target="_blank" rel="noopener noreferrer">
                  {t.cta.bookOnline}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="grid gap-4 lg:grid-cols-2">
          <article class="relative overflow-hidden rounded-[var(--radius-card)] bg-night p-6 text-ivory shadow-card md:p-8">
            <p class="inline-flex rounded-full bg-gold px-3 py-1 text-[0.7rem] font-medium tracking-[0.16em] uppercase text-night">
              {t.pricing.offerBadge}
            </p>
            <h2 class="mt-4 font-serif text-3xl text-ivory md:text-4xl">{t.pricing.offerTitle}</h2>
            <p class="mt-5 font-serif text-5xl tabular-nums text-gold">{formatUsd(pricing.introOffer.price)}</p>
            <p class="mt-3 text-ivory/88">{pricing.introOffer.label[locale]}</p>
            <p class="mt-2 text-sm text-ivory/75">{pricing.introOffer.detail[locale]}</p>
            <a class="btn btn-primary mt-6" href={book} target="_blank" rel="noopener noreferrer">
              {t.cta.bookOnline}
            </a>
          </article>

          <article class="card flex flex-col p-6 md:p-8">
            <p class="eyebrow">{t.pricing.moreEyebrow}</p>
            <h2 class="mt-3 font-serif text-3xl md:text-4xl">{pricing.couples.label[locale]}</h2>
            <p class="mt-5 font-serif text-5xl tabular-nums text-ink">{formatUsd(pricing.couples.price)}</p>
            <a class="btn btn-ghost mt-auto pt-6" href={book} target="_blank" rel="noopener noreferrer">
              {t.cta.bookOnline}
            </a>
          </article>
        </div>

        <div>
          <p class="eyebrow">{t.pricing.packagesEyebrow}</p>
          <h2 class="mt-2 font-serif text-3xl md:text-4xl">{t.pricing.packagesTitle}</h2>
          <ul class="mt-8 grid gap-4 md:grid-cols-2">
            {pricing.packages.map((option) => (
              <li class="card flex flex-col p-6 md:p-8">
                <p class="font-serif text-2xl text-ink md:text-3xl">{option.label[locale]}</p>
                <p class="mt-5 font-serif text-5xl tabular-nums text-ink">{formatUsd(option.price)}</p>
                <p class="mt-3 text-base text-gold-ink">{perSessionCopy(option.price, option.sessions)}</p>
                <a class="btn btn-ghost mt-6 w-full sm:w-auto" href={book} target="_blank" rel="noopener noreferrer">
                  {t.cta.bookOnline}
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-5 max-w-2xl text-base leading-relaxed text-ink-soft">{t.pricing.packageNote}</p>
        </div>
      </div>
    )
  }

  {
    pricing.giftCards.enabled && (
      <div id="gift-cards" class="mt-16 scroll-mt-28 grid gap-4 md:grid-cols-2">
        <article class="card p-6 md:p-8">
          <p class="eyebrow">{t.pricing.giftCardsEyebrow}</p>
          <h2 class="mt-3 font-serif text-3xl">{t.pricing.giftCardsTitle}</h2>
          <p class="mt-4 leading-relaxed text-ink-soft">{t.pricing.giftCardsBody}</p>
          <a class="btn btn-primary mt-6" href={gift}>
            {t.pricing.giftCardsCta}
          </a>
        </article>
        <article class="card p-6 md:p-8">
          <PaymentNote locale={locale} />
        </article>
      </div>
    )
  }

  {
    !pricing.giftCards.enabled && (
      <div class="mt-16">
        <PaymentNote locale={locale} />
      </div>
    )
  }
</section>
