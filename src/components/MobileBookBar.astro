---
import { copy, site } from '../lib/content';
import { whatsappUrl, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
---

<div
  class="fixed inset-x-0 bottom-0 z-50 grid grid-cols-3 border-t border-sand bg-cream/95 text-center text-xs font-medium tracking-wide uppercase backdrop-blur md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
>
  <a class="flex min-h-14 flex-col items-center justify-center gap-1 py-3 text-ink" href={`tel:${site.phoneTel}`}>{t.cta.call}</a>
  <a
    class="flex min-h-14 flex-col items-center justify-center gap-1 border-x border-sand py-3 text-gold-ink"
    href={whatsappUrl(site.whatsapp, t.cta.whatsappPrefill)}
  >
    {t.cta.whatsapp}
  </a>
  <a class="flex min-h-14 flex-col items-center justify-center gap-1 py-3 text-ink" href={`mailto:${site.email}`}>{t.cta.email}</a>
</div>
