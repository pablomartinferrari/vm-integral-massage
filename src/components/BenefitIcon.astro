---
interface Props {
  id: string;
  class?: string;
}
const { id, class: className = 'h-6 w-6' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    id === 'monthly-massage' && (
      <>
        <circle cx="12" cy="12" r="8.25" />
        <path d="M8.5 13.5c1.2 1.4 2.6 2 3.5 2s2.3-.6 3.5-2" />
        <path d="M9 10h.01M15 10h.01" />
      </>
    )
  }
  {
    id === 'promotions' && (
      <>
        <path d="M4.5 12.5 12.5 4.5h6v6L10.5 18.5a2.1 2.1 0 0 1-3 0l-3-3a2.1 2.1 0 0 1 0-3Z" />
        <circle cx="16.25" cy="7.75" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    id === 'complementary' && (
      <>
        <path d="M12 20c4-3.2 6-6.2 6-9.2A6 6 0 0 0 6 10.8C6 13.8 8 16.8 12 20Z" />
        <path d="M12 9.5c.2-1.8 1.5-3 2.8-3" />
      </>
    )
  }
  {
    id === 'priority' && (
      <>
        <rect x="4" y="5.5" width="16" height="14" rx="2" />
        <path d="M8 3.5v4M16 3.5v4M4 10h16" />
        <path d="M9.5 14.2 11.2 16l3.4-3.6" />
      </>
    )
  }
  {
    id === 'rollover' && (
      <>
        <path d="M7 7.5A6.5 6.5 0 1 1 5.8 14" />
        <path d="M7 4.5v3.2H3.8" />
        <path d="M12 9v4l2.5 1.5" />
      </>
    )
  }
  {
    id === 'gift-cards' && (
      <>
        <rect x="3.5" y="8" width="17" height="12" rx="1.5" />
        <path d="M3.5 12h17" />
        <path d="M12 8v12" />
        <path d="M12 8c-1.6-2.4-3.8-2.6-4.6-1.4C6.5 8 8.4 9.6 12 12" />
        <path d="M12 8c1.6-2.4 3.8-2.6 4.6-1.4.9 1.4-1 3-4.6 5.4" />
      </>
    )
  }
  {
    id === 'family' && (
      <>
        <circle cx="9" cy="8" r="2.2" />
        <circle cx="15.5" cy="8.5" r="1.8" />
        <path d="M4.8 18.5c.4-3 2.2-4.6 4.2-4.6s3.8 1.6 4.2 4.6" />
        <path d="M13.2 14.4c1.5-.6 3.3-.3 4.5 1.2.6.8 1 1.8 1.2 2.9" />
      </>
    )
  }
  {
    id === 'referral' && (
      <>
        <path d="M16.5 7.5 20 4l.2 3.6M20 4l-3.4.5" />
        <circle cx="9" cy="10" r="3" />
        <path d="M4 19c.5-3.2 2.4-5 5-5s4.5 1.8 5 5" />
        <path d="M16.2 13.2c1.6.4 2.8 1.8 3.3 4.3" />
      </>
    )
  }
  {
    id === 'birthday' && (
      <>
        <path d="M5 11.5c0-2.4 3.1-3.4 7-3.4s7 1 7 3.4V19H5z" />
        <path d="M5 15h14" />
        <path d="M12 8.1V5.4" />
        <path d="M12 5.4c.7-.7 1.4-1.1 1.4-1.8A1.4 1.4 0 0 0 12 2.2" />
      </>
    )
  }
  {
    ![
      'monthly-massage',
      'promotions',
      'complementary',
      'priority',
      'rollover',
      'gift-cards',
      'family',
      'referral',
      'birthday',
    ].includes(id) && <circle cx="12" cy="12" r="7" />
  }
</svg>
