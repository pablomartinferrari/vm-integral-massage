---
import { copy, site } from '../lib/content';
import { tPath, type Locale, type PageKey } from '../lib/i18n';
import { whatsappUrl } from '../lib/i18n';

interface Props {
  locale: Locale;
  page: PageKey;
  alternatePath: string;
}
const { locale, page, alternatePath } = Astro.props;
const t = copy(locale);
const links: { key: PageKey; href: string }[] = [
  { key: 'home', href: tPath(locale, 'home') },
  { key: 'about', href: tPath(locale, 'about') },
  { key: 'services', href: tPath(locale, 'services') },
  { key: 'contact', href: tPath(locale, 'contact') },
];
const wa = whatsappUrl(site.whatsapp, t.cta.whatsappPrefill);
---

<header class="sticky top-0 z-40 border-b border-white/10 bg-night/95 text-ivory backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 md:px-6">
    <a href={tPath(locale, 'home')} class="flex min-w-0 items-center gap-3">
      <img
        src="/images/brand/logo-on-black.jpg"
        alt={site.brandName}
        width="56"
        height="56"
        class="h-12 w-12 rounded-full object-cover ring-1 ring-gold/40 md:h-14 md:w-14"
      />
      <span class="truncate font-serif text-lg tracking-wide text-ivory md:text-xl">
        {site.brandName}
      </span>
    </a>

    <nav class="hidden items-center gap-7 text-sm tracking-wide text-ivory/80 lg:flex" aria-label="Primary">
      {
        links.map((item) => (
          <a
            href={item.href}
            class:list={[
              'hover:text-gold transition-colors',
              page === item.key && 'text-gold',
            ]}
            aria-current={page === item.key ? 'page' : undefined}
          >
            {t.nav[item.key]}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={alternatePath}
        class="rounded-full border border-white/15 px-3 py-1.5 text-xs tracking-[0.14em] uppercase text-ivory/80 hover:border-gold hover:text-gold"
        lang={locale === 'en' ? 'es' : 'en'}
        hreflang={locale === 'en' ? 'es-US' : 'en-US'}
      >
        {t.nav.otherLanguage}
      </a>
      <a
        href={wa}
        class="hidden rounded-full bg-gold px-4 py-2 text-xs font-medium tracking-[0.12em] uppercase text-night hover:bg-gold-deep hover:text-cream sm:inline-flex"
      >
        {t.nav.bookNow}
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/15 lg:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">{t.nav.menu}</span>
        <span class="flex flex-col gap-1.5" aria-hidden="true">
          <span class="block h-px w-4 bg-ivory"></span>
          <span class="block h-px w-4 bg-ivory"></span>
          <span class="block h-px w-4 bg-ivory"></span>
        </span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" hidden class="border-t border-white/10 px-4 py-4 lg:hidden">
    <nav class="flex flex-col gap-3 text-base" aria-label="Mobile">
      {
        links.map((item) => (
          <a href={item.href} class="py-1 text-ivory/90">
            {t.nav[item.key]}
          </a>
        ))
      }
      <a href={tPath(locale, 'journal')} class="py-1 text-ivory/90">{t.nav.journal}</a>
      <a href={wa} class="mt-2 rounded-full bg-gold px-4 py-3 text-center text-sm tracking-wide text-night">
        {t.nav.bookNow}
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = panel?.hasAttribute('hidden') ?? true;
    if (!panel) return;
    if (open) panel.removeAttribute('hidden');
    else panel.setAttribute('hidden', '');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
