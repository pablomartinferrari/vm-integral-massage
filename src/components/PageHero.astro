---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  onDark?: boolean;
  id?: string;
  headingLevel?: 'h1' | 'h2';
}
const { eyebrow, title, lede, id, headingLevel = 'h1' } = Astro.props;
const HeadingTag = headingLevel;
---

<section id={id} class:list={['bg-night text-ivory', id && 'scroll-mt-32']}>
  <div class="mx-auto max-w-6xl px-4 py-14 md:px-6 md:py-20">
    <p class="eyebrow eyebrow-on-dark">{eyebrow}</p>
    <div class="gold-rule mt-4 bg-gold"></div>
    <HeadingTag class="mt-5 max-w-3xl font-serif text-[2.35rem] leading-[1.12] text-ivory md:text-5xl lg:text-[3.35rem]" style="color: var(--color-ivory)">
      {title}
    </HeadingTag>
    {
      lede && (
        <p class="lede mt-5 max-w-2xl text-pretty text-ivory/88">{lede}</p>
      )
    }
    <slot />
  </div>
</section>
