---
import { copy, site } from '../lib/content';
import { whatsappUrl, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
  heading?: string;
}
const { locale, heading } = Astro.props;
const t = copy(locale);
---

<section class="relative overflow-hidden bg-night text-ivory">
  <img
    src="/images/candles.jpg"
    alt=""
    width="1600"
    height="900"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 h-full w-full object-cover opacity-25"
  />
  <div class="relative mx-auto max-w-4xl px-4 py-16 text-center md:py-20">
    <p class="eyebrow eyebrow-on-dark">{t.contactPage.eyebrow}</p>
    <h2 class="mt-4 font-serif text-4xl md:text-5xl" style="color: var(--color-ivory)">{heading ?? t.contactPage.title}</h2>
    <p class="mx-auto mt-4 max-w-xl text-ivory/88">{t.hero.secondary}</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">{t.cta.bookOnline}</a>
      <a class="btn btn-secondary" href={whatsappUrl(site.whatsapp, t.cta.whatsappPrefill)}>{t.cta.bookWhatsApp}</a>
      <a class="btn btn-secondary" href={`tel:${site.phoneTel}`}>
        {t.cta.call} {site.phoneDisplay}
      </a>
      <a class="btn btn-secondary" href={`mailto:${site.email}`}>
        {t.cta.email}
      </a>
    </div>
  </div>
</section>
