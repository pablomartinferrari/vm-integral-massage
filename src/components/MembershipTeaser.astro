---
import { copy, site, pricing, formatUsd } from '../lib/content';
import { tPath, whatsappUrl, type Locale } from '../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy(locale);
const m = pricing.membership;
const join = whatsappUrl(site.whatsapp, t.cta.membershipPrefill);
const highlights = m.benefits.slice(0, 3);
---

{
  pricing.showPrices && m.enabled && (
    <section class="px-4 pb-4 md:px-6 md:pb-6">
      <article class="mx-auto grid max-w-6xl overflow-hidden rounded-[var(--radius-card)] bg-night text-ivory shadow-card md:grid-cols-2">
        <img
          src="/images/candles.jpg"
          alt=""
          width="900"
          height="700"
          loading="lazy"
          decoding="async"
          class="h-64 w-full object-cover md:h-full"
        />
        <div class="flex flex-col justify-center p-8 md:p-12">
          <p class="eyebrow eyebrow-on-dark">{t.pricing.membershipEyebrow}</p>
          <h2 class="mt-3 font-serif text-4xl" style="color: var(--color-ivory)">{m.name[locale]}</h2>
          <p class="mt-3 font-serif text-xl italic text-gold">{m.tagline[locale]}</p>
          <p class="mt-6 font-serif text-5xl tabular-nums text-gold">
            {formatUsd(m.price)}
            <span class="ml-2 align-middle font-sans text-sm tracking-[0.14em] uppercase text-ivory/80">
              {m.period[locale]}
            </span>
          </p>
          <ul class="mt-6 space-y-2 text-base text-ivory/88">
            {highlights.map((benefit) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gold"></span>
                <span>{benefit.title[locale]}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="btn btn-primary" href={join}>
              {m.cta[locale]}
            </a>
            <a class="btn btn-secondary" href={`${tPath(locale, 'pricing')}#membership`}>
              {m.learnMore[locale]}
            </a>
          </div>
        </div>
      </article>
    </section>
  )
}
