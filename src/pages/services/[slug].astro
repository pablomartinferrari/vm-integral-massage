---
import ServiceDetailPage from '../../components/pages/ServiceDetailPage.astro';
import { services, serviceBySlug } from '../../lib/content';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slugs.en },
    props: { service },
  }));
}

const { service } = Astro.props;
const resolved = service ?? serviceBySlug('en', Astro.params.slug ?? '');
if (!resolved) throw new Error('Unknown service');
---
<ServiceDetailPage locale="en" service={resolved} />
